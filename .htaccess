# ============================================================
# SECURITY (added 2026-09-28): the document root for this site IS the
# project root, not public/ - so without this block, anything not
# inside public/ is directly reachable by browsing straight to its
# path (.env, storage/logs/*.log, vendor/, composer.json, etc.), even
# though the rewrite rules below never send real traffic there. Same
# fix applied to izmafood.com the same day - see that repo's .htaccess
# for the identical, live-verified block. This has to sit above
# everything else in this file: Apache serves a request that matches
# a real existing file before any RewriteRule below even runs.
# ============================================================

# Every dotfile: .env, .git, editor swapfiles, etc.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Source/config/dependency directories - the app only ever needs to
# serve what's under public/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|docs)(/|$) - [F,L]
</IfModule>

# Known sensitive file types, wherever they sit in the tree.
<FilesMatch "\.(env|log|sql|sqlite|bak|swp|dist|yml|yaml|lock|md|sh|ini|conf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Known sensitive files by exact name (no useful extension to match on).
<FilesMatch "^(artisan|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|webpack\.mix\.js|vite\.config\.js|migratephoto\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Force non-WWW
    RewriteCond %{HTTP_HOST} ^www\.sallaamti\.com [NC]
    RewriteRule ^(.*)$ https://sallaamti.com/$1 [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Serve real files that live inside /public directly (css, js, images, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else goes through the Laravel front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ server.php [L]
</IfModule>